# Proposed settings for W01/W04. Not a claim these are already consumed by v0.2.
# No credentials belong in this template. Do not overwrite existing .env.
AEGIS_PORT=8765
AEGIS_DATA_MODE=live
AEGIS_EXECUTION_MODE=paper_local
AEGIS_ALLOW_LIVE_MONEY=false
AEGIS_SYNTHETIC_FALLBACK=false
AEGIS_LLM_PROVIDER=openrouter
AEGIS_ENABLE_PAID_LLM=false
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY_FILE=/absolute/private/path/to/openrouter.key
AEGIS_OPENROUTER_POLICY=configs/openrouter.policy.json
AEGIS_OPENROUTER_MODELS_LOCK=configs/openrouter.models.lock.json
ALPACA_DATA_FEED=iex
# ALPACA_API_KEY_FILE=/absolute/private/path/to/alpaca-paper-key
# ALPACA_SECRET_KEY_FILE=/absolute/private/path/to/alpaca-paper-secret
# SEC_USER_AGENT=Actual authorized operator and contact email
AEGIS_MODEL_DEVICE=cpu
# AEGIS_MODELS_DIR=/absolute/path/to/verified/models
# Management keys intentionally omitted: never provide them to the application.
